{
  "name": "@reviewpilot/contracts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "format": "prettier --write package.json tsconfig.json src/index.ts src/validate.ts src/review.ts tests scripts openapi schemas/task-v1.json schemas/task-v2.json --log-level warn",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "lint": "eslint src tests scripts",
    "codegen": "node scripts/generate.mjs",
    "contracts:check": "node scripts/check.mjs",
    "test:unit": "cd ../.. && vitest run --config vitest.config.ts packages/contracts/tests"
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "yaml": "2.9.1"
  }
}
