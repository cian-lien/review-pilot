{
  "$schema": "https://turborepo.com/schema.json",
  "agentGuidance": false,
  "remoteCache": {
    "enabled": false
  },
  "globalDependencies": ["tsconfig.base.json", "eslint.config.mjs"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "format:review": { "cache": false },
    "@reviewpilot/contracts#test:unit": { "cache": false },
    "test:review": { "cache": false, "passThroughEnv": ["REVIEW_TEST_ISOLATED", "REVIEW_CASE"] },
    "typegen": { "cache": false },
    "@reviewpilot/web#typecheck": { "dependsOn": ["typegen"], "outputs": [] },
    "@reviewpilot/web#build": {
      "dependsOn": ["typegen", "transit"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "infra:build": { "cache": false },
    "infra:migrate": {
      "cache": false,
      "passThroughEnv": [
        "GITHUB_*",
        "SESSION_SECRET*",
        "*_WORKER_SERVICE_TOKEN*",
        "OTEL_*",
        "COMPOSE_*",
        "DOCKER_*"
      ]
    },
    "infra:cutover": {
      "cache": false,
      "passThroughEnv": [
        "GITHUB_*",
        "SESSION_SECRET*",
        "*_WORKER_SERVICE_TOKEN*",
        "OTEL_*",
        "COMPOSE_*",
        "DOCKER_*"
      ]
    },
    "cutover:check": {
      "cache": false,
      "passThroughEnv": [
        "DATABASE_URL*",
        "RABBITMQ_URL*",
        "APP_URL",
        "GITHUB_*",
        "SESSION_SECRET*",
        "*_WORKER_SERVICE_TOKEN*"
      ]
    },
    "verify:migration": { "cache": false },
    "infra:check": {
      "cache": false
    },
    "infra:up": {
      "cache": false,
      "passThroughEnv": [
        "APP_HOST",
        "SECRET_DIRECTORY",
        "GITHUB_*",
        "SESSION_SECRET*",
        "*_WORKER_SERVICE_TOKEN*",
        "OTEL_*",
        "COMPOSE_*",
        "DOCKER_*"
      ]
    },
    "infra:stop": {
      "cache": false,
      "passThroughEnv": ["APP_HOST", "SECRET_DIRECTORY", "COMPOSE_*", "DOCKER_*"]
    },
    "format:infra": {
      "cache": false
    },
    "ui": {
      "cache": false
    },
    "format:ui": {
      "cache": false
    },
    "dispatcher": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "RABBITMQ_URL",
        "APP_URL",
        "API_BIND_ADDR",
        "INTERNAL_BIND_ADDR",
        "INTERNAL_API_URL",
        "GITHUB_*",
        "SESSION_SECRET",
        "REVIEW_PIPELINE_VERSION",
        "REVIEW_WORKER_SERVICE_TOKEN",
        "EVOLUTION_WORKER_SERVICE_TOKEN",
        "OTEL_*",
        "DATABASE_URL_FILE",
        "RABBITMQ_URL_FILE",
        "SESSION_SECRET_FILE",
        "*_WORKER_SERVICE_TOKEN_FILE",
        "HEARTBEAT_FILE"
      ]
    },
    "fixtures:legacy": {
      "cache": false
    },
    "format:migration": {
      "cache": false
    },
    "test:migration": {
      "cache": false
    },
    "@reviewpilot/api#typecheck": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "@reviewpilot/contracts#typecheck": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "@reviewpilot/observability#typecheck": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "@reviewpilot/worker-runtime#typecheck": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "@reviewpilot/api#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "APP_URL",
        "API_BIND_ADDR",
        "INTERNAL_BIND_ADDR",
        "DATABASE_URL",
        "RABBITMQ_URL",
        "INTERNAL_API_URL",
        "REVIEW_WORKER_SERVICE_TOKEN",
        "EVOLUTION_WORKER_SERVICE_TOKEN",
        "GITHUB_*",
        "SESSION_SECRET",
        "REVIEW_PIPELINE_VERSION",
        "OTEL_*",
        "DATABASE_URL_FILE",
        "RABBITMQ_URL_FILE",
        "SESSION_SECRET_FILE",
        "*_WORKER_SERVICE_TOKEN_FILE",
        "HEARTBEAT_FILE"
      ]
    },
    "@reviewpilot/api#start": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "APP_URL",
        "API_BIND_ADDR",
        "INTERNAL_BIND_ADDR",
        "DATABASE_URL",
        "RABBITMQ_URL",
        "INTERNAL_API_URL",
        "REVIEW_WORKER_SERVICE_TOKEN",
        "EVOLUTION_WORKER_SERVICE_TOKEN",
        "GITHUB_*",
        "SESSION_SECRET",
        "REVIEW_PIPELINE_VERSION",
        "OTEL_*",
        "DATABASE_URL_FILE",
        "RABBITMQ_URL_FILE",
        "SESSION_SECRET_FILE",
        "*_WORKER_SERVICE_TOKEN_FILE",
        "HEARTBEAT_FILE"
      ]
    },
    "deps": {
      "cache": false
    },
    "deps:info": {
      "cache": false
    },
    "codegen": {
      "cache": false
    },
    "contracts:check": {
      "cache": false
    },
    "@reviewpilot/api#build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.go-version",
        "$TURBO_ROOT$/packages/contracts/**"
      ],
      "outputs": ["bin/**"]
    },
    "@reviewpilot/api#test:unit": {
      "cache": false,
      "passThroughEnv": [
        "TEST_DATABASE_URL",
        "REVIEW_*",
        "TEST_MODEL_BASE_URL",
        "TEST_GITHUB_BASE_URL",
        "TEST_RABBITMQ_URL",
        "SCENARIO_RESULT_PATH",
        "MIGRATION_DIRECTORY"
      ]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build", "transit"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "$TURBO_ROOT$/.env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"],
      "env": [
        "NEXT_PUBLIC_*",
        "NEXT_TELEMETRY_DISABLED",
        "APP_URL",
        "DATABASE_URL",
        "GITHUB_APP_ID",
        "GITHUB_APP_SLUG",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",
        "GITHUB_PRIVATE_KEY_PATH",
        "GITHUB_WEBHOOK_SECRET",
        "SESSION_SECRET",
        "REVIEW_PIPELINE_VERSION"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "APP_URL",
        "GITHUB_*",
        "SESSION_SECRET",
        "REVIEW_PIPELINE_VERSION",
        "NEXT_TELEMETRY_DISABLED",
        "PORT"
      ]
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "APP_URL",
        "GITHUB_*",
        "SESSION_SECRET",
        "REVIEW_PIPELINE_VERSION",
        "NEXT_TELEMETRY_DISABLED",
        "PORT"
      ]
    },
    "typecheck": {
      "dependsOn": ["transit"],
      "outputs": ["*.tsbuildinfo"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/scripts/**",
        "$TURBO_ROOT$/tests/**",
        "$TURBO_ROOT$/vitest*.ts"
      ]
    },
    "lint": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/**",
        "$TURBO_ROOT$/tests/**",
        "$TURBO_ROOT$/*.ts",
        "$TURBO_ROOT$/*.mjs"
      ],
      "outputs": []
    },
    "@reviewpilot/tooling#typecheck": {
      "dependsOn": ["transit"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/scripts/**",
        "$TURBO_ROOT$/tests/**",
        "$TURBO_ROOT$/vitest*.ts"
      ]
    },
    "format": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^test"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tests/fixtures/**",
        "$TURBO_ROOT$/vitest.config.ts"
      ],
      "outputs": []
    },
    "@reviewpilot/tooling#test": {
      "dependsOn": ["^test"],
      "cache": false
    },
    "test:unit": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tests/fixtures/**",
        "$TURBO_ROOT$/vitest.config.ts"
      ],
      "outputs": []
    },
    "test:integration": {
      "cache": false
    },
    "db:migrate": {
      "cache": false,
      "passThroughEnv": [
        "DATABASE_URL",
        "DATABASE_URL_FILE",
        "GITHUB_*",
        "APP_URL",
        "SESSION_SECRET*",
        "RABBITMQ_URL*",
        "*_WORKER_SERVICE_TOKEN*"
      ]
    },
    "worker:review": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "RABBITMQ_URL",
        "INTERNAL_API_URL",
        "REVIEW_WORKER_SERVICE_TOKEN",
        "OTEL_*",
        "RABBITMQ_URL_FILE",
        "*_WORKER_SERVICE_TOKEN_FILE",
        "HEARTBEAT_FILE"
      ]
    },
    "worker:evolution": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "RABBITMQ_URL",
        "INTERNAL_API_URL",
        "EVOLUTION_WORKER_SERVICE_TOKEN",
        "OTEL_*",
        "RABBITMQ_URL_FILE",
        "*_WORKER_SERVICE_TOKEN_FILE",
        "HEARTBEAT_FILE"
      ]
    },
    "@reviewpilot/web#start": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["PORT", "SERVER_HOSTNAME", "NEXT_TELEMETRY_DISABLED"]
    },
    "@reviewpilot/web#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["PORT", "SERVER_HOSTNAME", "NEXT_TELEMETRY_DISABLED"]
    }
  }
}
