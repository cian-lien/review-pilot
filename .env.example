MODEL_API_KEY=
MODEL_API_KEY_FILE=
NEXT_TELEMETRY_DISABLED=1
API_BIND_ADDR=127.0.0.1:4000
INTERNAL_BIND_ADDR=127.0.0.1:4001
INTERNAL_API_URL=http://127.0.0.1:4001
RABBITMQ_URL=amqp://reviewpilot:reviewpilot@127.0.0.1:5672
REVIEW_WORKER_SERVICE_TOKEN=
EVOLUTION_WORKER_SERVICE_TOKEN=
GRAFANA_ADMIN_PASSWORD=
OTEL_EXPORTER_OTLP_ENDPOINT=
