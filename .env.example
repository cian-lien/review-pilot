DATABASE_URL=postgresql://reviewpilot:reviewpilot@127.0.0.1:5432/reviewpilot
APP_URL=http://localhost:8080
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
SESSION_SECRET=
