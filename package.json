{
  "name": "review-pilot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "db:migrate": "turbo run db:migrate",
    "worker:review": "turbo run worker:review",
    "worker:evolution": "turbo run worker:evolution",
    "infra:up": "turbo run infra:up --filter=@reviewpilot/tooling",
    "infra:stop": "turbo run infra:stop --filter=@reviewpilot/tooling",
    "infra:check": "turbo run infra:check --filter=@reviewpilot/tooling",
    "cutover:check": "turbo run cutover:check --filter=@reviewpilot/tooling",
    "verify:migration": "turbo run verify:migration --filter=@reviewpilot/tooling"
  },
  "devDependencies": {
    "turbo": "2.11.7",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "eslint": "10.12.0",
    "typescript-eslint": "8.71.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "tsx": "4.23.15",
    "embedded-postgres": "18.4.0-beta.17",
    "prettier": "3.9.9",
    "@reviewpilot/domain": "workspace:*",
    "@reviewpilot/persistence": "workspace:*",
    "@reviewpilot/github": "workspace:*",
    "pg": "8.23.1",
    "zod": "4.6.5"
  }
}
